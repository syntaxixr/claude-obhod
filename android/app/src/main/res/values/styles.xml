<resources>
    <style name="Theme.Relay" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/accent</item>
        <item name="alertDialogTheme">@style/Dialog.Relay</item>
    </style>

    <!-- окна (правила, настройки) — как карточки Claude -->
    <style name="Dialog.Relay" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/dim</item>
        <item name="android:windowTitleStyle">@style/Dialog.Relay.Title</item>
        <item name="buttonBarButtonStyle">@style/Dialog.Relay.Button</item>
    </style>

    <style name="Dialog.Relay.Button" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Dialog.Relay.Title" parent="RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:textAppearance">@style/Dialog.Relay.TitleText</item>
    </style>

    <style name="Dialog.Relay.TitleText" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
